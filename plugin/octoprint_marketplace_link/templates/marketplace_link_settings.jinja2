<form class="form-horizontal">
    <h4>{{ _('Webhook') }}</h4>

    <div class="control-group">
        <label class="control-label">{{ _('URL') }}</label>
        <div class="controls">
            <input type="url" class="input-block-level"
                   placeholder="https://meusite.com/api/octoprint"
                   data-bind="value: settingsViewModel.settings.plugins.marketplace_link.webhook_url">
            <span class="help-block">
                {{ _('URL completa que receberá os POSTs JSON com o estado da impressora.') }}
            </span>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Token (Bearer)') }}</label>
        <div class="controls">
            <input type="password" class="input-block-level"
                   placeholder="opcional"
                   data-bind="value: settingsViewModel.settings.plugins.marketplace_link.auth_token">
            <span class="help-block">
                {{ _('Se preenchido, será enviado no header Authorization: Bearer.') }}
            </span>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Marca') }}</label>
        <div class="controls">
            <select data-bind="value: settingsViewModel.settings.plugins.marketplace_link.brand">
                <option value="creality">Creality</option>
                <option value="elegoo">Elegoo</option>
                <option value="prusa">Prusa</option>
                <option value="bambu">Bambu Lab</option>
                <option value="other">{{ _('Outra') }}</option>
            </select>
            <span class="help-block">
                {{ _('Para Bambu Lab via MQTT direto, ative "Modo Bambu Lab" abaixo — a marca será forçada para "bambu" no payload.') }}
            </span>
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Modelo') }}</label>
        <div class="controls">
            <input type="text" placeholder="Ex.: Ender 3 V2"
                   data-bind="value: settingsViewModel.settings.plugins.marketplace_link.model">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">{{ _('Heartbeat (min)') }}</label>
        <div class="controls">
            <input type="number" min="0" max="60" style="width: 6em;"
                   data-bind="value: settingsViewModel.settings.plugins.marketplace_link.heartbeat_minutes">
            <span class="help-block">
                {{ _('Posta um evento "heartbeat" a cada N minutos para o site saber que a impressora ainda está viva. 0 desativa.') }}
            </span>
        </div>
    </div>

    <div class="control-group">
        <div class="controls">
            <button type="button" class="btn" data-bind="click: testWebhook">
                {{ _('Testar webhook') }}
            </button>
            <span data-bind="text: testResult"></span>
        </div>
    </div>

    <hr>
    <h4>{{ _('Bambu Lab (MQTT direto)') }}</h4>

    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox"
                       data-bind="checked: settingsViewModel.settings.plugins.marketplace_link.bambu_enabled">
                {{ _('Habilitar modo Bambu Lab') }}
            </label>
            <span class="help-block">
                {{ _('Conecta direto no broker MQTT da impressora Bambu na rede local. Útil porque impressoras Bambu não aparecem para o OctoPrint via porta serial. Use apenas se a marca selecionada acima for Bambu Lab.') }}
            </span>
        </div>
    </div>

    <div data-bind="visible: settingsViewModel.settings.plugins.marketplace_link.bambu_enabled">
        <div class="alert alert-warning" style="margin-left: 180px; margin-right: 20px;">
            <strong>{{ _('Atenção:') }}</strong>
            {{ _('o acesso MQTT local da Bambu depende do firmware. Versões muito recentes podem exigir Developer Mode habilitado na impressora. Veja o README para detalhes.') }}
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Host (IP local)') }}</label>
            <div class="controls">
                <input type="text" placeholder="192.168.0.123"
                       data-bind="value: settingsViewModel.settings.plugins.marketplace_link.bambu_host">
                <span class="help-block">
                    {{ _('IP da impressora na rede. Recomenda-se reservar IP fixo no roteador (DHCP reservation).') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Serial Number') }}</label>
            <div class="controls">
                <input type="text" placeholder="01PS00A0B0000001"
                       data-bind="value: settingsViewModel.settings.plugins.marketplace_link.bambu_serial">
                <span class="help-block">
                    {{ _('Serial da impressora. Pegar em Settings → Device Info na tela da Bambu.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Access Code') }}</label>
            <div class="controls">
                <input type="password" placeholder="8 dígitos"
                       data-bind="value: settingsViewModel.settings.plugins.marketplace_link.bambu_access_code">
                <span class="help-block">
                    {{ _('Código de 8 dígitos exibido em Settings → WLAN → "Access Code" na tela da Bambu. É a senha do MQTT local.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Modelo Bambu') }}</label>
            <div class="controls">
                <select data-bind="value: settingsViewModel.settings.plugins.marketplace_link.bambu_model">
                    <option value="">({{ _('usa o campo "Modelo" acima') }})</option>
                    <option value="A1">A1</option>
                    <option value="A1 Mini">A1 Mini</option>
                    <option value="P1S">P1S</option>
                    <option value="P1P">P1P</option>
                    <option value="X1C">X1 Carbon</option>
                </select>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <button type="button" class="btn" data-bind="click: testBambu">
                    {{ _('Testar conexão Bambu') }}
                </button>
                <span data-bind="text: bambuTestResult"></span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Status atual') }}</label>
            <div class="controls">
                <span data-bind="text: bambuStatusLabel"></span>
                <div class="muted" data-bind="visible: bambuFirmware, text: 'Firmware: ' + bambuFirmware()"></div>
                <div class="muted" data-bind="visible: bambuLastError">
                    <strong>{{ _('Último erro:') }}</strong>
                    <code data-bind="text: bambuLastError"></code>
                </div>
            </div>
        </div>
    </div>

    <hr>
    <h4>{{ _('Última entrega') }}</h4>

    <div class="control-group">
        <label class="control-label">{{ _('Status') }}</label>
        <div class="controls">
            <span class="label" data-bind="text: deliveryLabel, css: deliveryClass"></span>
            <span class="muted" data-bind="visible: lastDeliveryAgo, text: lastDeliveryAgo"
                  style="margin-left: 0.5em;"></span>
        </div>
    </div>

    <div class="control-group" data-bind="visible: settingsViewModel.settings.plugins.marketplace_link.last_delivery_error">
        <label class="control-label">{{ _('Último erro') }}</label>
        <div class="controls">
            <code data-bind="text: settingsViewModel.settings.plugins.marketplace_link.last_delivery_error"></code>
        </div>
    </div>
</form>
